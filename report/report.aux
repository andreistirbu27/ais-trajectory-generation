\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Two v5 (epoch\nobreakspace  {}54) predictions whose final waypoint terminates on land (signed-distance to coast $>$ 25\,km inland in both cases). Grey blocks are land masses (rasterised GSHHS coastline at $0.05^\circ $); white is water. Green solid is the ground-truth route, red dashed is the v5 prediction, dotted orange is the great-circle baseline, and the black \texttt  {X} marks the v5 final waypoint. Red dots flag every v5 waypoint with $\text  {sdf\_km}>0$ (on land). The model has no explicit notion of where land is; nothing in the per-step displacement loss penalises a final-waypoint excursion into the continental interior. Land awareness is added in v10 (Section\nobreakspace  {}\ref  {sec:v10}).\relax }}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:motiv-v5}{{6}{16}{Two v5 (epoch~54) predictions whose final waypoint terminates on land (signed-distance to coast $>$ 25\,km inland in both cases). Grey blocks are land masses (rasterised GSHHS coastline at $0.05^\circ $); white is water. Green solid is the ground-truth route, red dashed is the v5 prediction, dotted orange is the great-circle baseline, and the black \texttt {X} marks the v5 final waypoint. Red dots flag every v5 waypoint with $\text {sdf\_km}>0$ (on land). The model has no explicit notion of where land is; nothing in the per-step displacement loss penalises a final-waypoint excursion into the continental interior. Land awareness is added in v10 (Section~\ref {sec:v10}).\relax }{figure.caption.10}{}}

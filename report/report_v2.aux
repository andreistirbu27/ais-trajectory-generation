\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces System overview. An encoder produces $163$ memory tokens ($3$ conditioning + $5 \times 32$ retrieval); a windowed-causal decoder generates one displacement per step; training optimises a four-term loss including a differentiable land penalty; three inference-time passes (hard land projection, linear endpoint correction, WaterRouter snap to connected water) finish the route. All components are described in detail in Section\nobreakspace  {}\ref  {sec:methodology}.\relax }}{7}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch_intro}{{1}{7}{System overview. An encoder produces $163$ memory tokens ($3$ conditioning + $5 \times 32$ retrieval); a windowed-causal decoder generates one displacement per step; training optimises a four-term loss including a differentiable land penalty; three inference-time passes (hard land projection, linear endpoint correction, WaterRouter snap to connected water) finish the route. All components are described in detail in Section~\ref {sec:methodology}.\relax }{figure.caption.6}{}}
